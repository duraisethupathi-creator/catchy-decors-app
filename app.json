{
  "expo": {
    "name": "CATCHY DECORS",
    "slug": "catchy-decors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "catchydecors",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101D4A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.catchydecors.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#101D4A"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101D4A",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "googleAndroidClientId": "19095519328-ghdjoe9qkbm85icfv3prar25mm71lhg9.apps.googleusercontent.com",
      "googleWebClientId": "19095519328-u67nd4pelmj34bg9p3boqnkg7d23t55p.apps.googleusercontent.com"
    }
  }
}
